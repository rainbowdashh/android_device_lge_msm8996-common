soong_namespace {
}

cc_prebuilt_library_shared {
    name: "libbinder-v32",
    vendor_available: true,
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: ["prebuilt/arm/libbinder-v32.so"],
        },
        android_arm64: {
            srcs: ["prebuilt/arm64/libbinder-v32.so"],
        },
    },
    compile_multilib: "both",
    check_elf_files: false,
}

cc_library_shared {
    name: "lge_msm8996_display_config",
    stem: "vendor.qti.hardware.display.config-V12-ndk",
    vendor: true,
    compile_multilib: "64",
    whole_static_libs: [
        "//vendor/qcom/opensource/commonsys-intf/display:vendor.qti.hardware.display.config-V12-ndk",
    ],
    shared_libs: [
        "android.hardware.common-V2-ndk",
        "libbinder_ndk",
    ],
}
